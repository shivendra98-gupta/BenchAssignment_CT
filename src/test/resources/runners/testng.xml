<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Complete Test Automation Suite" verbose="2">
    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
    </listeners>

    <test name="E-Commerce Checkout Flow Tests">
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
            <class name="com.saucedemo.tests.ProductCatalogTest"/>
            <class name="com.saucedemo.tests.CartTest"/>
            <class name="com.saucedemo.tests.CheckoutTest"/>
            <class name="com.saucedemo.tests.EndToEndCheckoutTest"/>
            <class name="com.saucedemo.tests.PDFConfirmationTest"/>
        </classes>
    </test>
</suite>
